---
interface Props {
  title?: string;
}
const { title = "GoatGambling" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <div class="fx scanlines"></div>
    <div class="fx vignette"></div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #06060a;
    --ink: #d9ccb0;
    --dim: #7d7461;
    --blood: #b3201a;
    --grass: #5fbf4a;
    --lamp: #ffd98a;
    font-family: "Courier New", ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); overflow: hidden; }
  body { user-select: none; }
  a { color: inherit; text-decoration: none; }

  .fx { position: fixed; inset: 0; pointer-events: none; z-index: 50; }
  .scanlines {
    background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0 2px, rgba(0,0,0,0.28) 3px);
    mix-blend-mode: multiply;
    animation: flicker 5s infinite;
  }
  .vignette { background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.7) 100%); }
  @keyframes flicker {
    0%, 100% { opacity: 1; } 47% { opacity: 1; } 48% { opacity: 0.8; } 50% { opacity: 1; } 83% { opacity: 0.9; }
  }

  .btn {
    display: inline-block; cursor: pointer; font: inherit; letter-spacing: 0.25em; text-transform: uppercase;
    padding: 0.9rem 2.2rem; color: var(--ink); background: rgba(0,0,0,0.55);
    border: 2px solid var(--ink); box-shadow: 0 0 0 4px #000, 0 0 24px rgba(0,0,0,0.9);
    transition: transform 0.1s, color 0.1s, border-color 0.1s, box-shadow 0.1s;
  }
  .btn:hover:not(:disabled) {
    color: var(--lamp); border-color: var(--lamp); transform: translateY(-2px);
    box-shadow: 0 0 0 4px #000, 0 0 28px rgba(255,217,138,0.35);
  }
  .btn:active:not(:disabled) { transform: translateY(1px); }
  .btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .goat {
    line-height: 1; user-select: none;
    filter: grayscale(1) brightness(0.32) contrast(1.5) drop-shadow(0 0 28px rgba(179,32,26,0.75));
  }
</style>
