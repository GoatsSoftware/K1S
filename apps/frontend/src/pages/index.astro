---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout title="GoatGambling — Menu">
  <main class="menu">
    <div class="lamp"></div>

    <div class="stage">
      <div class="goat dealer" id="dealer">🐐</div>
      <h1 class="logo">GOAT<span>GAMBLING</span></h1>
      <div class="table"></div>
    </div>

    <nav class="panel">
      <input id="player" maxlength="32" placeholder="TON NOM" autocomplete="off" />
      <a class="btn" id="play" href="/play">Jouer</a>
      <button class="btn" id="board-btn" type="button">Classement</button>
    </nav>

    <aside class="board" id="board" hidden>
      <h2>Classement</h2>
      <ol id="scores"></ol>
      <button class="btn small" id="close" type="button">Fermer</button>
    </aside>
  </main>
</Layout>

<style>
  .menu { position: fixed; inset: 0; display: grid; place-items: center; perspective: 900px; }
  .lamp {
    position: absolute; top: -10%; left: 50%; width: 80vmax; height: 90vh; transform: translateX(-50%);
    background: radial-gradient(ellipse at top, rgba(255,217,138,0.28), rgba(255,217,138,0.06) 45%, transparent 70%);
    animation: sway 6s ease-in-out infinite;
  }
  @keyframes sway { 50% { transform: translateX(-50%) rotate(1.5deg); } }

  .stage {
    position: relative; width: min(90vw, 760px); height: 62vh; transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
  }
  .dealer { position: absolute; top: 2%; left: 50%; transform: translateX(-50%); font-size: min(26vh, 14rem); }
  .logo {
    position: absolute; top: 46%; left: 0; right: 0; margin: 0; text-align: center;
    font-size: clamp(2.4rem, 8vw, 5.6rem); letter-spacing: 0.12em; line-height: 0.95; color: var(--ink);
    text-shadow: 0 0 18px rgba(255,217,138,0.35), 0 4px 0 #000, 0 12px 24px #000;
    transform: translateZ(70px) rotateX(10deg);
  }
  .logo span { display: block; color: var(--blood); text-shadow: 0 0 24px rgba(179,32,26,0.6), 0 4px 0 #000; }
  .table {
    position: absolute; left: -15%; right: -15%; bottom: -8%; height: 38%;
    transform-origin: top; transform: rotateX(64deg);
    background:
      repeating-linear-gradient(90deg, rgba(0,0,0,0.25) 0 2px, transparent 2px 46px),
      linear-gradient(#3a2415, #1a0f08);
    box-shadow: inset 0 0 80px #000, 0 0 60px #000;
  }

  .panel { position: absolute; bottom: 7vh; display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; justify-content: center; z-index: 10; }
  input {
    font: inherit; letter-spacing: 0.2em; text-align: center; text-transform: uppercase; color: var(--lamp);
    background: rgba(0,0,0,0.7); border: 2px solid var(--dim); padding: 0.9rem 1rem; width: 14rem; outline: none;
  }
  input:focus { border-color: var(--lamp); }

  .board {
    position: absolute; z-index: 20; inset: 0; margin: auto; width: min(90vw, 28rem); height: fit-content; padding: 2rem;
    background: rgba(5,5,8,0.99); border: 2px solid var(--ink); box-shadow: 0 0 0 4px #000, 0 0 80px #000;
  }
  .board[hidden] { display: none; }
  h2 { margin: 0 0 1rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--blood); }
  ol { margin: 0 0 1.5rem; padding-left: 2rem; min-height: 4rem; line-height: 1.9; }
  .small { padding: 0.5rem 1.2rem; }
</style>

<script>
  import { api, getPlayer, setPlayer } from "../scripts/api";

  const player = document.getElementById("player") as HTMLInputElement;
  const board = document.getElementById("board") as HTMLElement;
  const scores = document.getElementById("scores") as HTMLElement;
  const stage = document.querySelector(".stage") as HTMLElement;

  player.value = getPlayer() === "Player" ? "" : getPlayer();
  player.addEventListener("input", () => setPlayer(player.value.trim() || "Player"));

  async function showBoard() {
    board.hidden = false;
    const result = await api("leaderboard");
    scores.replaceChildren(
      ...(result.scores ?? []).map((s: { player_name: string; score: number }) => {
        const li = document.createElement("li");
        li.textContent = `${s.player_name} — ${s.score}`;
        return li;
      }),
    );
    if (!scores.children.length) {
      const li = document.createElement("li");
      li.textContent = result.success ? "Personne n'a encore joué." : (result.error ?? "Erreur");
      scores.append(li);
    }
  }

  document.getElementById("board-btn")!.addEventListener("click", showBoard);
  document.getElementById("close")!.addEventListener("click", () => (board.hidden = true));
  if (new URLSearchParams(location.search).has("board")) showBoard();

  // Subtle camera parallax following the mouse.
  window.addEventListener("mousemove", (e) => {
    const x = (e.clientX / innerWidth - 0.5) * 2;
    const y = (e.clientY / innerHeight - 0.5) * 2;
    stage.style.transform = `rotateY(${x * 6}deg) rotateX(${-y * 4}deg)`;
  });
</script>
