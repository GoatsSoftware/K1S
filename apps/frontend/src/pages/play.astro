---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout title="GoatGambling — Table">
  <main class="room" id="room">
    <div class="lamp"></div>

    <header class="hud">
      <a href="/" class="back">◀ Menu</a>
      <div class="balance">🌿 <span id="balance">…</span></div>
    </header>

    <div class="scene" id="scene">
      <div class="goat dealer">🐐</div>
      <div class="table"></div>
      <div class="die-wrap" id="die-wrap">
        <div class="die" id="die"></div>
      </div>
      <div class="shadow" id="shadow"></div>
    </div>

    <section class="controls">
      <div id="message" class="message">Fais ta mise.</div>
      <div class="bet">
        <button class="btn small" id="minus" type="button">−</button>
        <div class="amount">MISE <b id="amount">1</b></div>
        <button class="btn small" id="plus" type="button">+</button>
        <button class="btn" id="roll" type="button">Lancer</button>
        <button class="btn cash" id="cashout" type="button">Se retirer</button>
      </div>
      <div class="odds">1-3 PERDU · 4 ×1,25 · 5 ×1,5 · 6 ×2 &nbsp;|&nbsp; mise max = moitié du solde</div>
    </section>
  </main>
</Layout>

<style>
  .room { position: fixed; inset: 0; transition: filter 0.2s; }
  .room.shake { animation: shake 0.45s; }
  .room.win-flash { animation: win 0.7s; }
  @keyframes shake {
    10%, 90% { transform: translate(-3px, 1px); } 30%, 70% { transform: translate(6px, -2px); } 50% { transform: translate(-6px, 3px); }
  }
  @keyframes win { 0% { filter: brightness(1.9) sepia(1) hue-rotate(60deg); } 100% { filter: none; } }

  .lamp {
    position: absolute; top: -12%; left: 50%; width: 90vmax; height: 100vh; transform: translateX(-50%);
    background: radial-gradient(ellipse at top, rgba(255,217,138,0.3), rgba(255,217,138,0.05) 50%, transparent 72%);
    animation: sway 7s ease-in-out infinite;
  }
  @keyframes sway { 50% { transform: translateX(-50%) rotate(-1.5deg); } }

  .hud { position: absolute; z-index: 60; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 3rem; }
  .back { padding: 0.6rem 1.2rem; font-size: 1rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); background: rgba(0,0,0,0.75); border: 2px solid var(--ink); }
  .back:hover { color: var(--lamp); border-color: var(--lamp); }
  .balance {
    padding: 0.5rem 1.4rem; font-size: 2.2rem; font-weight: bold; letter-spacing: 0.1em; color: #9dff7e;
    background: rgba(0,0,0,0.75); border: 2px solid var(--grass); box-shadow: 0 0 20px rgba(95,191,74,0.35);
    text-shadow: 0 0 12px rgba(157,255,126,0.7);
  }

  .scene {
    position: absolute; inset: 0 0 26vh 0; perspective: 900px; perspective-origin: 50% 35%;
    transition: transform 0.15s ease-out;
  }
  .dealer { position: absolute; top: 4%; left: 50%; transform: translateX(-50%); font-size: min(30vh, 16rem); }
  .table {
    position: absolute; left: -20%; right: -20%; top: 48%; bottom: -30%;
    transform-origin: top; transform: rotateX(62deg);
    background:
      repeating-linear-gradient(90deg, rgba(0,0,0,0.28) 0 2px, transparent 2px 52px),
      radial-gradient(ellipse at 50% 20%, #5a3a21, #1c1009 75%);
    box-shadow: inset 0 0 120px #000;
  }

  .die-wrap { position: absolute; left: 50%; top: 62%; width: 0; height: 0; perspective: 700px; }
  .die {
    --s: 120px; position: absolute; width: var(--s); height: var(--s); margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    transform-style: preserve-3d; transform: rotateX(-24deg) rotateY(28deg);
    transition: transform 1.6s cubic-bezier(0.15, 0.7, 0.2, 1);
  }
  .die :global(.face) {
    position: absolute; inset: 0; display: grid; grid: repeat(3, 1fr) / repeat(3, 1fr); padding: 18px; gap: 8px;
    background: linear-gradient(145deg, #e8dcc0, #a89c80); border: 2px solid #3b3425; border-radius: 10px;
    backface-visibility: hidden; box-shadow: inset 0 0 18px rgba(0,0,0,0.45);
  }
  .die :global(.pip) { border-radius: 50%; }
  .die :global(.pip.on) { background: radial-gradient(circle at 35% 30%, #4a4338, #0e0c09); }
  .die :global(.face.lose .pip.on) { background: radial-gradient(circle at 35% 30%, #d03a30, #5a0d09); }
  .die :global(.f1) { transform: translateZ(60px); }
  .die :global(.f2) { transform: rotateY(180deg) translateZ(60px); }
  .die :global(.f3) { transform: rotateY(90deg) translateZ(60px); }
  .die :global(.f4) { transform: rotateY(-90deg) translateZ(60px); }
  .die :global(.f5) { transform: rotateX(90deg) translateZ(60px); }
  .die :global(.f6) { transform: rotateX(-90deg) translateZ(60px); }

  .shadow {
    position: absolute; left: 50%; top: 72%; width: 160px; height: 30px; margin-left: -80px;
    background: radial-gradient(ellipse, rgba(0,0,0,0.75), transparent 70%); transition: transform 0.2s;
  }

  .controls {
    position: absolute; z-index: 10; left: 0; right: 0; bottom: 0; height: 26vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center; gap: 1rem; padding: 0 1rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.75));
  }
  .message { min-height: 1.6rem; font-size: 1.2rem; letter-spacing: 0.15em; text-transform: uppercase; text-align: center; }
  .message.win { color: var(--grass); text-shadow: 0 0 16px rgba(95,191,74,0.7); }
  .message.lose { color: var(--blood); text-shadow: 0 0 16px rgba(179,32,26,0.7); }
  .bet { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; justify-content: center; }
  .amount { letter-spacing: 0.2em; font-size: 1.1rem; min-width: 8rem; text-align: center; }
  .amount b { color: var(--lamp); font-size: 1.8rem; }
  .small { padding: 0.5rem 1.1rem; }
  .cash { border-color: var(--blood); color: #ff6a5f; }
  .cash:hover:not(:disabled) { border-color: #ff6a5f; color: #ff9a92; box-shadow: 0 0 0 4px #000, 0 0 28px rgba(179,32,26,0.5); }
  .odds { color: var(--dim); font-size: 0.8rem; letter-spacing: 0.1em; text-align: center; }
</style>

<script>
  import { api, getPlayer } from "../scripts/api";

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const room = $("room");
  const scene = $("scene");
  const die = $("die");
  const dieWrap = $("die-wrap");
  const message = $("message");
  const rollBtn = $("roll") as HTMLButtonElement;
  const minusBtn = $("minus") as HTMLButtonElement;
  const plusBtn = $("plus") as HTMLButtonElement;
  const cashBtn = $("cashout") as HTMLButtonElement;

  const PIPS: Record<number, number[]> = {
    1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8],
  };
  // Cube rotation (x, y) that brings face n to the front.
  const FACE_ROTATION: Record<number, [number, number]> = {
    1: [0, 0], 2: [0, 180], 3: [0, -90], 4: [0, 90], 5: [-90, 0], 6: [90, 0],
  };

  for (let n = 1; n <= 6; n++) {
    const face = document.createElement("div");
    face.className = `face f${n}${n <= 3 ? " lose" : ""}`;
    for (let i = 0; i < 9; i++) {
      const pip = document.createElement("span");
      pip.className = `pip${PIPS[n].includes(i) ? " on" : ""}`;
      face.append(pip);
    }
    die.append(face);
  }

  let balance = 0;
  let amount = 1;
  let spins = 0;
  let busy = false;

  const maxBet = () => Math.floor(balance / 2);

  function render() {
    amount = Math.max(1, Math.min(amount, maxBet()));
    $("balance").textContent = String(balance);
    $("amount").textContent = String(maxBet() >= 1 ? amount : 0);
    minusBtn.disabled = busy || amount <= 1;
    plusBtn.disabled = busy || amount >= maxBet();
    rollBtn.disabled = busy || maxBet() < 1;
    cashBtn.disabled = busy;
  }

  async function loadBalance() {
    const result = await api("balance");
    if (result.success) balance = result.balance;
    else message.textContent = result.error ?? "Erreur";
    if (result.success && maxBet() < 1) {
      message.className = "message lose";
      message.textContent = "Plus assez d'herbe. La chèvre a gagné.";
    }
    render();
  }

  function throwDie(roll: number): Promise<void> {
    spins += 1;
    const [x, y] = FACE_ROTATION[roll];
    die.style.transform = `rotateX(${x + 720 * spins}deg) rotateY(${y + 720 * spins}deg)`;
    dieWrap.animate(
      [{ transform: "translateY(0)" }, { transform: "translateY(-220px)", offset: 0.4 }, { transform: "translateY(0)" }],
      { duration: 1600, easing: "ease-in-out" },
    );
    return new Promise((resolve) => setTimeout(resolve, 1700));
  }

  function flash(cls: string) {
    room.classList.remove("shake", "win-flash");
    void room.offsetWidth;
    room.classList.add(cls);
  }

  rollBtn.addEventListener("click", async () => {
    busy = true;
    render();
    message.className = "message";
    message.textContent = "…";
    const result = await api("bet", { amount, player_name: getPlayer() });
    if (!result.success) {
      busy = false;
      message.className = "message lose";
      message.textContent = result.error ?? "Erreur";
      return loadBalance();
    }
    await throwDie(result.roll);
    message.className = `message ${result.win ? "win" : "lose"}`;
    message.textContent = result.win ? `Gagné ! +${result.payout} 🌿` : `Perdu… -${amount} 🌿`;
    flash(result.win ? "win-flash" : "shake");
    balance = result.balance;
    busy = false;
    if (maxBet() < 1) {
      message.className = "message lose";
      message.textContent = "Plus assez d'herbe. La chèvre a gagné.";
    }
    render();
  });

  cashBtn.addEventListener("click", async () => {
    busy = true;
    render();
    const result = await api("cashout", { player_name: getPlayer() });
    if (!result.success) {
      busy = false;
      message.className = "message lose";
      message.textContent = result.error ?? "Erreur";
      return render();
    }
    balance = result.score;
    render();
    message.className = "message win";
    message.textContent = `Tu te retires avec ${result.score} 🌿 — score enregistré !`;
    setTimeout(() => (location.href = "/?board=1"), 2200);
  });

  minusBtn.addEventListener("click", () => { amount -= 1; render(); });
  plusBtn.addEventListener("click", () => { amount += 1; render(); });

  window.addEventListener("mousemove", (e) => {
    const x = (e.clientX / innerWidth - 0.5) * 2;
    const y = (e.clientY / innerHeight - 0.5) * 2;
    scene.style.transform = `rotateY(${x * 4}deg) rotateX(${-y * 2}deg)`;
  });

  loadBalance();
</script>
